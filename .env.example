DATABASE_URL="your-neon-pooled-connection-string"
DIRECT_URL="your-neon-direct-connection-string"
ANTHROPIC_API_KEY="your-anthropic-api-key"
NEXTAUTH_SECRET="pick-any-long-random-string-like-vyral-labs-super-secret-2025"
NEXTAUTH_URL="https://your-vercel-app-url.vercel.app"

# Comments inbox
# ViralDeck workspace API key (viraldeck.io → Settings → API)
VIRALDECK_API_KEY=
# viral.app API key (Artie org; also used for live comment fetching)
VIRAL_APP_API_KEY=
# Apify API token (console.apify.com → Settings → API & Integrations).
# Optional: enables reading replies on TikTok/Instagram to detect creator replies.
APIFY_TOKEN=
# Random secret Vercel cron sends as a Bearer token
CRON_SECRET=
# Auto-reply bot: encrypts stored Page/channel tokens (any long random string)
TOKEN_ENCRYPTION_KEY=
# Meta app (developers.facebook.com) with Facebook Login + Pages permissions
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Facebook Login for Business configuration id (Configurations tab)
FACEBOOK_CONFIG_ID=
# Google Cloud OAuth client (Web) with YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
