generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  password            String
  color               String           @default("blue")
  avatarUrl           String?
  role                String           @default("member")
  active              Boolean          @default(true)
  hooks               Hook[]
  votes               HookVote[]
  comments            HookComment[]
  validatedHooks      ValidatedHook[]
  notifications       Notification[]
  campaignMemberships CampaignMember[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Campaign {
  id                 String          @id @default(cuid())
  name               String
  clientName         String
  description        String?
  color              String          @default("blue")
  emoji              String          @default("🎯")
  active             Boolean         @default(true)
  archivedManually   Boolean         @default(false)
  hooksTarget        Int             @default(7)
  validatedTarget    Int             @default(7)
  hashtags           String?
  validatedSheetUrl  String?
  logoUrl            String?
  contractEndDate    DateTime?
  weeks              Week[]
  members            CampaignMember[]
  validatedHooks     ValidatedHook[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Week {
  id                String              @id @default(cuid())
  campaignId        String
  campaign          Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  weekStart         DateTime
  deadline          DateTime
  status            String              @default("open")
  mode              String              @default("mixed")
  notes             String?
  newHooksSheetUrl  String?
  hooks             Hook[]
  selectedValidated WeekValidatedHook[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([campaignId, weekStart])
}

model Hook {
  id             String        @id @default(cuid())
  weekId         String
  week           Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  submittedById  String?
  submittedBy    User?         @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  submitterName  String
  hookText       String
  format         String        @default("Faceless")
  caption        String
  country             String?
  referenceVideo      String?
  recordingNotes      String?
  requiresAppFootage  Boolean       @default(false)
  appFootageSource    String?
  status              String        @default("submitted")
  isSelected     Boolean       @default(false)
  selectedOrder  Int?
  aiCaption      String?
  wentViral      Boolean       @default(false)
  votes          HookVote[]
  comments       HookComment[]
  suggestions    HookSuggestion[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ValidatedHook {
  id             String              @id @default(cuid())
  campaignId     String
  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  hookText       String
  format         String              @default("Faceless")
  caption        String              @default("")
  referenceVideo String?
  recordingNotes String?
  sourceHookId   String?
  addedById      String?
  addedBy        User?               @relation(fields: [addedById], references: [id], onDelete: SetNull)
  notes          String?
  lastUsedAt     DateTime?
  timesUsed      Int                 @default(0)
  weekUsages     WeekValidatedHook[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model WeekValidatedHook {
  id              String        @id @default(cuid())
  weekId          String
  week            Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  validatedHookId String
  validatedHook   ValidatedHook @relation(fields: [validatedHookId], references: [id], onDelete: Cascade)
  selectedOrder   Int?
  createdAt       DateTime      @default(now())

  @@unique([weekId, validatedHookId])
}

model HookVote {
  id        String   @id @default(cuid())
  hookId    String
  hook      Hook     @relation(fields: [hookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@unique([hookId, userId])
}

model HookComment {
  id            String         @id @default(cuid())
  hookId        String
  hook          Hook           @relation(fields: [hookId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Notification {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromName  String
  commentId String?
  comment   HookComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  hookText  String
  weekId    String?
  type      String       @default("mention")
  read      Boolean      @default(false)
  createdAt DateTime     @default(now())
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("supporter") // "owner" | "supporter"
  createdAt  DateTime @default(now())

  @@unique([campaignId, userId])
}

model HookSuggestion {
  id          String   @id @default(cuid())
  hookId      String
  hook        Hook     @relation(fields: [hookId], references: [id], onDelete: Cascade)
  suggestedBy String
  hookText    String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model CalendarClient {
  id            String                    @id @default(cuid())
  name          String
  contractStart DateTime
  contractEnd   DateTime?
  firstPostDate DateTime?
  monthlyValue  Float?
  notes         String?
  contractLink  String?
  color         String                    @default("violet")
  source        String                    @default("manual")
  externalId    String?                   @unique
  archived      Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  extensions    CalendarClientExtension[]
}

model CalendarClientExtension {
  id           String         @id @default(cuid())
  clientId     String
  client       CalendarClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  monthlyValue Float?
  notes        String?
  createdAt    DateTime       @default(now())
}

model Shoutout {
  id        String   @id @default(cuid())
  toName    String
  message   String
  emoji     String   @default("🌟")
  createdAt DateTime @default(now())
}

model CreatorSheet {
  id               String   @id @default(cuid())
  client           String   @unique
  fileId           String
  languageColIndex Int?
  active           Boolean  @default(true)
  lastSyncedAt     DateTime?
  lastSyncCreated  Int?
  createdAt        DateTime @default(now())
}

model CreatorApplication {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  over18       Boolean  @default(true)
  location     String
  tiktok       String?
  instagram    String?
  notes        String?
  submittedAt  DateTime
  client             String   @default("Vyral Labs")
  status             String   @default("new")
  language           String?
  country            String?
  gender             String?
  ageRange           String?
  tiktokFollowers    Int?
  instagramFollowers Int?
  niche              String?
  referredBy         String?
  phone              String?
  chronicIllness     String?
  enrichedAt         DateTime?
  tags               String?
  internalNote       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([email, submittedAt, client])
}

// Cloud copy of the invoice tool's state (clients + statuses, history, billing
// details, counters, sender details, burn). One row per logical key, value is
// the JSON string the UI previously kept in localStorage.
model InvoiceData {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ── Comments inbox ───────────────────────────────────────────────────────────
// One row per tracker project: a ViralDeck project, or a whole viral.app org
// (source "viralapp", externalId "default"). Only enabled projects are synced;
// replyBrief is the per-campaign angle the AI uses when suggesting replies.
model CommentProject {
  id           String         @id @default(cuid())
  source       String         @default("viraldeck")
  externalId   String
  name         String
  enabled      Boolean        @default(false)
  replyBrief   String?
  minViews     Int            @default(10000)
  lookbackDays Int            @default(7)
  lastSyncedAt DateTime?
  videos       TrackedVideo[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([source, externalId])
}

model TrackedVideo {
  id                 String         @id @default(cuid())
  projectId          String
  project            CommentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform           String
  platformVideoId    String
  creatorHandle      String?
  title              String?
  url                String
  thumbnailUrl       String?
  publishedAt        DateTime?
  views              Int            @default(0)
  commentCount       Int            @default(0)
  lastSeenAt         DateTime       @default(now())
  commentsFetchedAt  DateTime?
  commentsFetchError String?
  comments           VideoComment[]
  createdAt          DateTime       @default(now())

  @@unique([platform, platformVideoId])
  @@index([projectId, publishedAt])
}

model VideoComment {
  id                String       @id @default(cuid())
  videoId           String
  video             TrackedVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  platformCommentId String
  authorHandle      String?
  text              String
  language          String?
  likeCount         Int          @default(0)
  // viral.app counts replies but doesn't list them: 0 means nobody (creator
  // included) has answered yet.
  replyCount        Int          @default(0)
  // Set when the replies were actually read (Apify): did the creator answer?
  repliesChecked    Boolean      @default(false)
  creatorReplied    Boolean      @default(false)
  postedAt          DateTime?
  shareUrl          String?
  // high_intent | question | positive | negative | spam | other (null until triaged)
  intent            String?
  needsReply        Boolean      @default(false)
  suggestedReply    String?
  // Auto-reply bot (Facebook Pages / YouTube channels we're connected to)
  botReplyText      String?
  botReplyId        String?
  botRepliedAt      DateTime?
  botReplyError     String?
  // open | sent_to_creator | replied | dismissed
  status            String       @default("open")
  statusUpdatedBy   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([videoId, platformCommentId])
  @@index([needsReply, status])
}

// A creator's Facebook Page or YouTube channel connected via OAuth so the bot
// can read comments and reply as that account. Tokens are AES-GCM encrypted
// with TOKEN_ENCRYPTION_KEY.
model ConnectedAccount {
  id              String    @id @default(cuid())
  platform        String // facebook | youtube
  externalId      String // Page id / channel id
  name            String
  // Lowercased handles/ids matched against TrackedVideo.creatorHandle
  handles         String[]
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  autoReply       Boolean   @default(false)
  // When true the bot only drafts (botReplyText) without posting.
  dryRun          Boolean   @default(true)
  maxPerVideoDay  Int       @default(5)
  maxPerDay       Int       @default(30)
  connectedBy     String?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([platform, externalId])
}
