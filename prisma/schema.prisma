generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  password            String
  color               String           @default("blue")
  avatarUrl           String?
  role                String           @default("member")
  active              Boolean          @default(true)
  hooks               Hook[]
  votes               HookVote[]
  comments            HookComment[]
  validatedHooks      ValidatedHook[]
  notifications       Notification[]
  campaignMemberships CampaignMember[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Campaign {
  id                 String          @id @default(cuid())
  name               String
  clientName         String
  description        String?
  color              String          @default("blue")
  emoji              String          @default("🎯")
  active             Boolean         @default(true)
  hooksTarget        Int             @default(7)
  validatedTarget    Int             @default(7)
  hashtags           String?
  validatedSheetUrl  String?
  logoUrl            String?
  contractEndDate    DateTime?
  weeks              Week[]
  members            CampaignMember[]
  validatedHooks     ValidatedHook[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Week {
  id                String              @id @default(cuid())
  campaignId        String
  campaign          Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  weekStart         DateTime
  deadline          DateTime
  status            String              @default("open")
  mode              String              @default("mixed")
  notes             String?
  newHooksSheetUrl  String?
  hooks             Hook[]
  selectedValidated WeekValidatedHook[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([campaignId, weekStart])
}

model Hook {
  id             String        @id @default(cuid())
  weekId         String
  week           Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  submittedById  String?
  submittedBy    User?         @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  submitterName  String
  hookText       String
  format         String        @default("Faceless")
  caption        String
  referenceVideo      String?
  recordingNotes      String?
  requiresAppFootage  Boolean       @default(false)
  appFootageSource    String?
  status              String        @default("submitted")
  isSelected     Boolean       @default(false)
  selectedOrder  Int?
  aiCaption      String?
  wentViral      Boolean       @default(false)
  votes          HookVote[]
  comments       HookComment[]
  suggestions    HookSuggestion[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ValidatedHook {
  id             String              @id @default(cuid())
  campaignId     String
  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  hookText       String
  format         String              @default("Faceless")
  caption        String              @default("")
  referenceVideo String?
  recordingNotes String?
  sourceHookId   String?
  addedById      String?
  addedBy        User?               @relation(fields: [addedById], references: [id], onDelete: SetNull)
  notes          String?
  lastUsedAt     DateTime?
  timesUsed      Int                 @default(0)
  weekUsages     WeekValidatedHook[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model WeekValidatedHook {
  id              String        @id @default(cuid())
  weekId          String
  week            Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  validatedHookId String
  validatedHook   ValidatedHook @relation(fields: [validatedHookId], references: [id], onDelete: Cascade)
  selectedOrder   Int?
  createdAt       DateTime      @default(now())

  @@unique([weekId, validatedHookId])
}

model HookVote {
  id        String   @id @default(cuid())
  hookId    String
  hook      Hook     @relation(fields: [hookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@unique([hookId, userId])
}

model HookComment {
  id            String         @id @default(cuid())
  hookId        String
  hook          Hook           @relation(fields: [hookId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Notification {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromName  String
  commentId String?
  comment   HookComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  hookText  String
  weekId    String?
  type      String       @default("mention")
  read      Boolean      @default(false)
  createdAt DateTime     @default(now())
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("supporter") // "owner" | "supporter"
  createdAt  DateTime @default(now())

  @@unique([campaignId, userId])
}

model HookSuggestion {
  id          String   @id @default(cuid())
  hookId      String
  hook        Hook     @relation(fields: [hookId], references: [id], onDelete: Cascade)
  suggestedBy String
  hookText    String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model CalendarClient {
  id            String    @id @default(cuid())
  name          String
  contractStart DateTime
  contractEnd   DateTime?
  firstPostDate DateTime?
  monthlyValue  Float?
  notes         String?
  contractLink  String?
  color         String    @default("violet")
  source        String    @default("manual")
  externalId    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Shoutout {
  id        String   @id @default(cuid())
  toName    String
  message   String
  emoji     String   @default("🌟")
  createdAt DateTime @default(now())
}
