{
  "buildCommand": "prisma generate && prisma db push --accept-data-loss && next build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/creators/sync-sheet",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/creators/bulk-enrich",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/comments/cron?step=videos",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/comments/cron?step=comments",
      "schedule": "15 6-11,16-21 * * *"
    },
    {
      "path": "/api/comments/cron?step=reply",
      "schedule": "45 8-21 * * *"
    }
  ]
}
